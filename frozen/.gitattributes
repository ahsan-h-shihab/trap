# --- Frozen-artifact protection: no normalization, no LFS, ever ---
experiments/**/*.csv   -text
experiments/**/*.json  -text
experiments/**/*.md    -text
experiments/**/*.txt   -text
experiments/**/*.png   -text -filter -diff
*.py                   -text
README.md              -text
requirements.txt       -text

# --- LFS classes for FUTURE artifacts only (do not match any frozen path) ---
new_experiments/**/*.pdf   filter=lfs diff=lfs merge=lfs -text
new_experiments/**/*.bin   filter=lfs diff=lfs merge=lfs -text
